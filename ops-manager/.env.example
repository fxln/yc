# OpsManager 环境变量示例
# 复制为 .env 后使用 docker compose --env-file .env up -d

# 管理员初始账号（仅首次启动生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# HTTP/WebDAV 端口
HTTP_PORT=3000
WEBDAV_PORT=8081

# 密钥（务必替换为随机长字符串）
JWT_SECRET=ops-manager-change-this-secret-2026-xxxxxxxx
HOST_SECRET=ops-manager-host-secret-key-32bytes!!

# 时区
TZ=Asia/Shanghai
